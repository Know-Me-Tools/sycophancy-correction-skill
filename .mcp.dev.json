{
  "mcpServers": {
    "sycophancy-correction": {
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--bin",
        "sycophancy-correction",
        "--",
        "--config",
        "skill.toml"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "RUST_LOG": "debug"
      }
    }
  }
}
